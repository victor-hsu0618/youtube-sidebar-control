{
  "manifest_version": 3,
  "name": "YouTube Study Companion",
  "version": "2.5.0",
  "description": "Professional playback controls for learning: Speed, Loop, Bookmarks, and Notes.",
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs",
    "storage",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open YouTube Study Companion"
  },
  "commands": {
    "toggle-playback": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle Play/Pause"
    },
    "restart-marker": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Restart Active Marker"
    },
    "add-marker": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Add Marker (A)"
    }
  }
}
